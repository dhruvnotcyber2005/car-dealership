# Copy the backend values into backend/.env before you change them.
# These are placeholders. Do not put real passwords in this file.

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=60
DATABASE_URL=sqlite:///./dealership.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Used only by backend/create_admin.py
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional. The frontend defaults to http://localhost:8000.
# Copy this line into frontend/.env if the API runs somewhere else.
VITE_API_URL=http://localhost:8000
